# Viewly environment template
#
# This file IS committed to the repository, so it must only ever contain empty
# values or harmless placeholders. Real values belong in `.env.local`, which is
# git-ignored. Copy this template once, then fill in your own values:
#
#   macOS/Linux:  cp .env.example .env.local
#   Windows:      copy .env.example .env.local
#
# Next.js loads `.env*` files from the project root only, never from `src/`.
# Never commit `.env.local` and never put real credentials in this file.

# YouTube Data API v3 key
#
# Server-side only. Read it through `src/lib/env.ts`, which imports
# "server-only" so the module cannot be pulled into a Client Component.
#
# Never prefix this with NEXT_PUBLIC_: any variable with that prefix is inlined
# into the JavaScript sent to the browser at build time, which would leak the
# key to every visitor.
#
# Create the key in the Google Cloud Console with the "YouTube Data API v3"
# enabled (API Keys -> Create credentials), ideally restricted to that API.
YOUTUBE_API_KEY=
